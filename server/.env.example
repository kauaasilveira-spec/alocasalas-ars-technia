# Porta da API
PORT=3001
# Chave da API do Google Gemini (https://aistudio.google.com/apikey). Opcional.
GEMINI_API_KEY=
# Modelo Gemini utilizado para justificar recomendações
GEMINI_MODEL=gemini-2.5-flash
# Segredo para assinatura dos tokens JWT (troque em produção)
JWT_SECRET=troque-este-segredo
# Caminho do banco SQLite
DB_PATH=./alocasalas.db
